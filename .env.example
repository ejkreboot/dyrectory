# Supabase project settings (Project Settings → API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe to ship to the browser
PUBLIC_KEY=sb_publishable_...
# Secret key: used only by scripts/create-admin.mjs on your machine. Never deploy this to the frontend.
SECRET_KEY=sb_secret_...

# Optional: name shown in the app header and browser tab
# APP_NAME=Estate Organizer
